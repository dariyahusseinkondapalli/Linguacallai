# Generate a token: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_TOKEN=
HOST=127.0.0.1
PORT=3000
# Requests per process lifetime; restart resets this development-only allowance.
REQUEST_LIMIT=50
# Optional, operator-owned endpoint. No service is activated automatically.
LIBRETRANSLATE_URL=
LIBRETRANSLATE_API_KEY=
# Local beta account store; no transcripts. Back up securely.
DATABASE_PATH=./data/linguacall.sqlite
# Operator-supplied STUN/TURN. Empty supports local-network peer candidates only.
ICE_SERVERS_JSON=[]
