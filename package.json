{
  "name": "linguacallai",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm run dev -w @linguacall/api",
    "dev:mobile": "npm run start -w @linguacall/mobile",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "test": "vitest run",
    "build:api": "npm run build -w @linguacall/api",
    "build:web": "npm run build:web -w @linguacall/mobile",
    "test:browser": "tsx tests/browser.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/supertest": "^6.0.3",
    "esbuild": "^0.25.0",
    "eslint": "^9.39.0",
    "playwright": "^1.65.0",
    "supertest": "^7.1.4",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.46.0",
    "vitest": "^3.2.4"
  }
}
